+            loop {
+                tokio::time::sleep_until(deadline).await;
+                if validity.load(std::sync::atomic::Ordering::Acquire) != epoch {
+                    break;
+                }
+                if events
+                    .send(StatusLineCommandEvent::Tick { runtime, epoch })
